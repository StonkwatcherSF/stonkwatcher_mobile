{
  "expo": {
    "name": "StonkWatcher",
    "slug": "StonkWatcher",
    "version": "1.0.0",
    "scheme": "stonkwatcher",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.stonkwatcher.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "xyz.stonkwatcher.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#14203D",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StonkWatcher to access your photos so you can set a profile image.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0b41ca44-51dc-423a-b76d-dbefa913e5cf"
      }
    },
    "owner": "anony-dev"
  }
}
